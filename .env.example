# Скопируйте этот файл в .env и укажите IP вашего компьютера.
# Узнать IP: на ПК откройте cmd и введите ipconfig, смотрите "IPv4-адрес" (например 192.168.0.105).
# Телефон и ПК должны быть в одной Wi-Fi сети.
# Backend запускайте так: python manage.py runserver 0.0.0.0:8000

EXPO_PUBLIC_API_URL=http://192.168.0.15:8000/api
