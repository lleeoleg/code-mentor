# Скопируйте в .env и подставьте свои значения.
# Stripe (оплата курсов): секретный ключ из панели Stripe (Developers → API keys).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Опционально: URL фронтенда после оплаты (по умолчанию http://localhost:5173)
# FRONTEND_URL=http://localhost:5173

# ИИ-помощник (опционально)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash-lite
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini
